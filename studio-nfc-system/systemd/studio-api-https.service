[Unit]
Description=Studio NFC FastAPI service (HTTPS)
After=network.target
Conflicts=studio-api.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/studio-nfc
EnvironmentFile=-/opt/studio-nfc/.env
ExecStart=/opt/studio-nfc/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8443 --ssl-keyfile /opt/studio-nfc/data/key.pem --ssl-certfile /opt/studio-nfc/data/cert.pem
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
