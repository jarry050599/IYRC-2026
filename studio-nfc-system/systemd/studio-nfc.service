[Unit]
Description=Studio PN532 NFC reader
After=studio-api.service
Requires=studio-api.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/studio-nfc
EnvironmentFile=-/opt/studio-nfc/.env
ExecStart=/opt/studio-nfc/.venv/bin/python services/nfc_reader.py --api-url http://127.0.0.1:8000 --device usb
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

