[Unit]
Description=Studio NFC FastAPI service
After=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/studio-nfc
EnvironmentFile=-/opt/studio-nfc/.env
ExecStart=/opt/studio-nfc/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

